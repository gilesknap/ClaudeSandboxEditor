#!/usr/bin/env bash
# Stand-in for `uvx claude-sandbox@latest`: like `podman exec -it` it needs a TTY, it prints
# launcher noise (colours, a title escape, CRLF line ends from the PTY), and it runs
# `shell -c SCRIPT` with this folder first on the PATH, so `claude` is the fake next to this
# file, which then behaves like the container's shadow wrapper (see claude). Like the real
# `shell` verb it runs SCRIPT in $CLAUDE_SANDBOX_SHELL (bash when unset or missing).
# Flag file in $FAKE_CLAUDE_STATE: broken-launcher (fail like a missing container).
FAKES="$(cd "$(dirname "$0")" && pwd)"
if [ ! -t 0 ]; then
    echo "Error: the input device is not a TTY" >&2
    exit 1
fi
printf '\033]0;claude-sandbox\007\033[1;34mclaude-sandbox\033[0m: using container md-editor-fake (fake)\n' >&2
echo "Trying to pull ghcr.io/example/claude-sandbox:latest... {fake noise}" >&2
if [ "$#" -ne 3 ] || [ "$1" != "shell" ] || [ "$2" != "-c" ]; then
    echo "fake-sandbox: expected 'shell -c SCRIPT', got: $*" >&2
    exit 2
fi
if [ -n "$FAKE_CLAUDE_STATE" ] && [ -e "$FAKE_CLAUDE_STATE/broken-launcher" ]; then
    echo "Error: no container with name or ID \"md-editor-fake\" found: no such container" >&2
    exit 125
fi
if [ -n "$FAKE_CLAUDE_STATE" ]; then
    # record the script, its cwd, the environment and the prompt file's mode, for the tests
    pf=$(printf '%s' "$3" | grep -o "/[^' ]*\.md-editor-ask-[0-9a-f]*\.txt" | head -1)
    mode=$( [ -n "$pf" ] && stat -c %a "$pf" 2>/dev/null )
    python3 -c 'import json, os, sys
print(json.dumps({"script": sys.argv[1], "cwd": os.getcwd(), "prompt_file": sys.argv[2], "mode": sys.argv[3],
                  "tty": os.isatty(0), "term": os.environ.get("TERM"), "no_color": os.environ.get("NO_COLOR"),
                  "claudecode": os.environ.get("CLAUDECODE"), "shell": os.environ.get("CLAUDE_SANDBOX_SHELL"),
                  "child_session": os.environ.get("CLAUDE_CODE_CHILD_SESSION")}))' \
        "$3" "$pf" "$mode" >> "$FAKE_CLAUDE_STATE/sandbox.log"
fi
want="${CLAUDE_SANDBOX_SHELL:-bash}"
command -v "$want" >/dev/null || want=bash
FAKE_SANDBOX=1 PATH="$FAKES:$PATH" exec "$want" -c "$3"
